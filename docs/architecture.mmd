flowchart LR
  classDef module fill:#ffffff,stroke:#3b6fd8,stroke-width:1.5px,color:#0b1f44
  classDef edge fill:#f3f3f3,stroke:#8a8a8a,color:#222

  cli["xsat-cli<br/>DIMACS · limits · proofs"]:::edge
  dev["xsat-dev<br/>vs Kissat · proof checks · fuzzing"]:::edge

  subgraph lib["xsat"]
    direction LR
    api[Solver API]:::module
    subgraph run["solving"]
      direction TB
      cdcl[cdcl]:::module
      inproc[inprocess]:::module
      incr[incremental]:::module
      ext[external]:::module
    end
    subgraph data["state"]
      direction TB
      store[store]:::module
      trace[trace]:::module
    end
  end

  cli --> api
  dev -.-> api
  api --> run
  run --> data

  style lib fill:#eef4ff,stroke:#3b6fd8,stroke-width:1.5px,color:#0b1f44
  style run fill:#ffffff,stroke:#9db4e0,stroke-dasharray:4,color:#3b6fd8
  style data fill:#ffffff,stroke:#9db4e0,stroke-dasharray:4,color:#3b6fd8
