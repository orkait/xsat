flowchart TB
  classDef module fill:#ffffff,stroke:#8aa4d6,color:#0b1f44
  classDef outside fill:#f6f6f6,stroke:#9a9a9a,color:#333

  user([CNF file or library caller]):::outside

  subgraph cli["xsat-cli"]
    direction LR
    parse[DIMACS parser<br/>strict, relaxed, pedantic]:::module
    run[limits · proofs · workers<br/>model and statistics output]:::module
  end
  style cli fill:#eef4ff,stroke:#3b6fd8,stroke-width:1.5px,color:#0b1f44

  subgraph lib["xsat library"]
    direction TB
    api[Solver API<br/>add · solve · solve_assuming · freeze · connect · terminate]:::module
    cdcl[cdcl/<br/>propagate · analyze · minimize · shrink<br/>decide · restart · mode · reduce · walk]:::module
    inproc[inprocess/<br/>probe · backbone · substitute · vivify<br/>sweep · congruence · factor · eliminate]:::module
    incr[incremental/<br/>assumptions · reconstruction · restore]:::module
    store[store/<br/>arena · watches · trail · clauses · heap · queue]:::module
    ext[external/<br/>Propagator · ExternalClause · Gauss XOR]:::module
    trace[trace/<br/>DRAT · IDRUP · statistics]:::module
    par[parallel.rs<br/>deterministic portfolio]:::module
  end
  style lib fill:#eef4ff,stroke:#3b6fd8,stroke-width:1.5px,color:#0b1f44

  subgraph dev["xsat-dev"]
    direction LR
    cmp[compare with Kissat<br/>counters · parse · mutate]:::module
    ses[session fuzzer<br/>assumptions · IDRUP]:::module
    lrat[LRAT via drat-trim]:::module
  end
  style dev fill:#eef4ff,stroke:#3b6fd8,stroke-width:1.5px,color:#0b1f44

  kissat([Kissat 4.0.4]):::outside
  checkers([idrup-check · drat-trim · lrat-check]):::outside

  user --> parse --> api
  run --> api
  api --> cdcl
  api --> incr
  api --> ext
  api --> par
  cdcl <--> inproc
  cdcl --> store
  inproc --> store
  incr --> store
  ext --> cdcl
  cdcl --> trace
  inproc --> trace
  cmp --> kissat
  ses --> checkers
  lrat --> checkers
  dev -.uses.-> lib
